<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>XLinkViewer</AssemblyName>
    <RootNamespace>XLinkViewer</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <!-- Self-contained deployment without single file -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="V1\**" />
    <Compile Remove="GraphViewer\**" />
    <EmbeddedResource Remove="V1\**" />
    <EmbeddedResource Remove="GraphViewer\**" />
    <None Remove="V1\**" />
    <None Remove="GraphViewer\**" />
    <Page Remove="V1\**" />
    <Page Remove="GraphViewer\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.4.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Msagl" Version="1.1.6" />
    <PackageReference Include="Microsoft.Msagl.GraphViewerGDI" Version="1.1.7" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Copy wwwroot files for web-based graph visualization -->
    <None Include="GraphViewer\wwwroot\**\*">
      <Link>GraphViewer\wwwroot\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
